source leaprc.protein.ff19SB    # Load the protein FF19SB force field
source leaprc.DNA.bsc1          # Load the DNA bsc1 force field
source leaprc.water.tip4pew     # Load the TIP4PEW water model


loadoff ForceFieldFiles/parmBSC1.lib            # Load the parmBSC1 library file
loadAmberParams ForceFieldFiles/parmBSC1.frcmod # Load the parmBSC1 frcmod file

loadoff ForceFieldFiles/f-sugars.lib            # Load your custom library file
loadAmberParams ForceFieldFiles/f-sugars.frcmod # Load your custom frcmod file

# Load the PDB file of your molecule
mol = loadPdb Output/exampleRNA-OH/exampleRNA-OH_rename.pdb 

# Solvate the molecule in a box of TIP4PEW water
solvateBox mol TIP4PEWBOX 10.0

# Add ions to neutralize the system and reach 0.05 M MgCl2 concentration 
addIonsRand mol MG 10
addIonsRand mol Cl- 10 


# Save the parameter and coordinate files
saveAmberParm mol Output/exampleRNA-OH/exampleRNA-OH_solv.prmtop Output/exampleRNA-OH/exampleRNA-OH_solv.inpcrd
# Save the solvated PDB file for reference
savePdb mol Output/exampleRNA-OH/exampleRNA-OH_solvated.pdb
quit
